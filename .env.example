# 如果是本地运行，请修改该文件命名为.env，并正确填写下面的配置项

# 教程： # https://blog.liushen.fun/posts/dd89adc9/
# 该值可以不填写，也可以不绑定域名，因为action的国外环境，完全不影响使用。
PROXY_URL=https://nginx.example.com/

# 教程 https://blog.liushen.fun/posts/c2262998/#动态Json获取
# 【推荐】本地 JSON：由 friends_watcher.py 根据 Firefly 的 friendsConfig.ts 自动生成
# 格式: { link_list: [ {name, link, linkpage} ] }
SOURCE_URL=./friends.json
# 远程 JSON 格式也可（Firefly 博客的 friends.json 端点）：
# SOURCE_URL=https://blog.amamo.top/api/friends.json

# 作者网站地址，用于检测反链，仅填写域名部分即可，无需协议头
AUTHOR_URL=blog.amamo.top

# ===== 友链主页截图配置（新增）=====
# 图床上传端点（CloudFlare ImgBed /upload，cfbed.sanyue.de 兼容 API）
IMG_UPLOAD_URL=https://tu.520781.xyz/upload
# 上传认证 Token（imgbed_ 前缀的 API Token，从图床 Token 管理页获取）
IMG_AUTH_CODE=
# 上传目录（图床内的子目录），友链截图统一存放
IMG_UPLOAD_FOLDER=screenshot